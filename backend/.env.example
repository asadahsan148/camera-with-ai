# Copy to backend/.env and fill in your key.
# NEVER commit backend/.env

# Required for Phase 2B pretrained model benchmark (Roboflow — diagnostic only)
ROBOFLOW_API_KEY=

# Hugging Face Space — ball detector (Phase 2B)
# HF_SPACE_URL=https://yourname-scos-detector.hf.space

# Hugging Face Space — auto table corner calibration
# Set this after training + deploying the corner detector model
# HF_CORNER_SPACE_URL=https://asadahsan148-scos-corner-detector.hf.space

# Optional overrides
# ROBOFLOW_MODEL_ID=snooker-ball-detection-rnhxo-95km5/2
# ROBOFLOW_API_URL=https://serverless.roboflow.com
# AI_WORKER_URL=http://127.0.0.1:5051
# CALIB_FPS=4
# PORT=5050

# Frame State Manager — auto frame start/end detection
# FRAME_STATE_SAMPLE_MS=5000      # Sample interval (ms)
# FRAME_STATE_CONFIDENCE=0.4      # Ball detection confidence threshold
# FRAME_STATE_CONFIRM_COUNT=3     # Consecutive readings required to confirm state change
# FRAME_STATE_DETECTOR=roboflow-snooker  # Detector ID (roboflow-snooker | hf-space)
